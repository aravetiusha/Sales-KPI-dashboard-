<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sales KPI Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
body{
font-family:Arial,sans-serif;
background:#f4f4f4;
margin:20px;
}
h1{
text-align:center;
}
.cards{
display:flex;
flex-wrap:wrap;
gap:15px;
margin-bottom:20px;
}
.card{
background:white;
padding:15px;
border-radius:10px;
flex:1;
min-width:180px;
text-align:center;
box-shadow:0 2px 5px rgba(0,0,0,0.1);
}
.chart{
background:white;
padding:15px;
border-radius:10px;
box-shadow:0 2px 5px rgba(0,0,0,0.1);
}
</style>
</head>
<body>

<h1>Sales KPI Dashboard</h1>

<div class="cards">
<div class="card">
<h3>Total Sales</h3>
<h2>₹225,000</h2>
</div>

<div class="card">
<h3>Total Profit</h3>
<h2>₹44,500</h2>
</div>

<div class="card">
<h3>Total Orders</h3>
<h2>10</h2>
</div>

<div class="card">
<h3>Total Quantity</h3>
<h2>33</h2>
</div>
</div>

<div class="chart">
<canvas id="salesChart"></canvas>
</div>

<script>
new Chart(document.getElementById('salesChart'),{
type:'bar',
data:{
labels:['North','South','East','West'],
datasets:[{
label:'Sales',
data:[112000,38000,35000,40000]
}]
}
});
</script>

</body>
</html>